<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Connexion — Portail Crèches</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="login-body">
  <div class="login-container">
    <div class="login-card">
      <div class="login-header">
        <div class="login-logo">
          <img src="/logo-gray.png" alt="Pharmacie Gillain">
        </div>
        <h1 class="login-title">Portail Crèches</h1>
        <p class="login-subtitle">Approbation des commandes crèches &amp; foyers</p>
      </div>

      <% if (error) { %>
        <div class="alert alert-error">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
          <%= error %>
        </div>
      <% } %>

      <form method="POST" action="/login" class="login-form">
        <div class="form-group">
          <label for="password" class="form-label">Mot de passe</label>
          <input
            type="password"
            id="password"
            name="password"
            class="form-input"
            placeholder="Entrez le mot de passe"
            autofocus
            required
          >
        </div>
        <button type="submit" class="btn btn-primary btn-full">
          Se connecter
        </button>
      </form>
    </div>
    <p class="login-footer">Accès réservé — Portail Crèches</p>
  </div>
</body>
</html>
